# Snowflake Connection Template
# Copy this file to snowflake.yaml and fill in your actual credentials
# DO NOT commit the actual credentials file to version control

snowflake:
  account: "your_account.region.cloud"  # e.g., "abc123.us-east-1.aws"
  user: "your_username"
  password: "your_password"
  warehouse: "your_warehouse"
  database: "your_database"
  schema: "your_schema"
  role: "your_role"
  
# Alternative: Use environment variables (recommended for production)
# snowflake:
#   account: "${SNOWFLAKE_ACCOUNT}"
#   user: "${SNOWFLAKE_USER}"
#   password: "${SNOWFLAKE_PASSWORD}"
#   warehouse: "${SNOWFLAKE_WAREHOUSE}"
#   database: "${SNOWFLAKE_DATABASE}"
#   schema: "${SNOWFLAKE_SCHEMA}"
#   role: "${SNOWFLAKE_ROLE}"
