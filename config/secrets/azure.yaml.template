# Azure Connection Template
# Copy this file to azure.yaml and fill in your actual credentials
# DO NOT commit the actual credentials file to version control

azure:
  storage:
    account_name: "your_storage_account"
    account_key: "your_account_key"
    connection_string: "your_connection_string"
  
  key_vault:
    vault_url: "https://your-keyvault.vault.azure.net/"
    client_id: "your_client_id"
    client_secret: "your_client_secret"
    tenant_id: "your_tenant_id"
  
  data_lake:
    account_name: "your_datalake_account"
    filesystem_name: "your_filesystem"
    
# Alternative: Use environment variables (recommended for production)
# azure:
#   storage:
#     connection_string: "${AZURE_STORAGE_CONNECTION_STRING}"
#   key_vault:
#     vault_url: "${AZURE_KEY_VAULT_URL}"
