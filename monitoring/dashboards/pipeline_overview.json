{
  "dashboard": {
    "id": null,
    "title": "Data Pipeline Overview",
    "tags": ["data-pipeline", "airflow", "spark", "snowflake"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Pipeline Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(airflow_dag_run_success_total[1h]) / rate(airflow_dag_run_total[1h]) * 100",
            "legendFormat": "Success Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 80},
                {"color": "green", "value": 95}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Active DAG Runs",
        "type": "stat",
        "targets": [
          {
            "expr": "airflow_dag_run_running_total",
            "legendFormat": "Running DAGs"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Data Processing Volume",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(spark_job_records_processed_total[5m])) by (job_name)",
            "legendFormat": "{{job_name}}"
          }
        ],
        "yAxes": [
          {
            "label": "Records/sec",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Task Execution Times",
        "type": "heatmap",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(airflow_task_duration_seconds_bucket[5m]))",
            "legendFormat": "95th Percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 5,
        "title": "Error Rate by DAG",
        "type": "table",
        "targets": [
          {
            "expr": "rate(airflow_dag_run_failed_total[1h]) by (dag_id)",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "Snowflake Query Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "snowflake_query_duration_seconds",
            "legendFormat": "Query Duration"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 7,
        "title": "Data Quality Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "data_quality_validation_failures_total",
            "legendFormat": "Validation Failures"
          },
          {
            "expr": "data_quality_null_percentage",
            "legendFormat": "Null Percentage"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ],
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "custom",
          "options": [
            {"text": "Development", "value": "dev"},
            {"text": "Staging", "value": "staging"},
            {"text": "Production", "value": "prod"}
          ]
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "prometheus",
          "expr": "deployment_timestamp",
          "titleFormat": "Deployment",
          "textFormat": "Version {{version}}"
        }
      ]
    }
  }
}
